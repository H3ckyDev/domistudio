---
// DesignCard.astro
import { Sparkles, ArrowRight, ShoppingCart } from '@lucide/astro';

interface Props {
  className?: string;
}

const { className = "" } = Astro.props;
---

<div class={`relative bg-[#FAF6F0] rounded-[36px] p-7 sm:p-9 border border-[#E7DDD1] shadow-[0_20px_50px_-20px_rgba(45,32,24,0.07)] overflow-hidden flex flex-col justify-between group transition-all duration-500 hover:shadow-[0_25px_60px_-15px_rgba(45,32,24,0.14)] hover:-translate-y-1.5 ${className}`}>
  
  <!-- Subtle organic background shape (warm sand tone) -->
  <div class="absolute -bottom-16 -right-12 w-80 h-80 bg-[#E8DACB] rounded-full blur-2xl opacity-70 pointer-events-none transition-transform duration-700 group-hover:scale-110"></div>
  <div class="absolute bottom-4 right-0 w-64 h-64 bg-[#EADCCF]/80 rounded-[40%] rotate-12 pointer-events-none -z-0"></div>

  <!-- Top Content -->
  <div class="relative z-10">
    <!-- Pill Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E5DACE] text-[#2C241E] text-xs sm:text-sm font-medium tracking-wide shadow-sm">
      <Sparkles class="w-3.5 h-3.5 text-[#2C241E]" stroke-width={2.2} />
      <span>Diseño</span>
    </div>

    <!-- Title -->
    <h3 class="text-3xl sm:text-[34px] font-bold text-[#1C1613] tracking-tight leading-[1.15] mt-6">
      Ideas que <br />
      se ven increíbles
    </h3>

    <!-- Description -->
    <p class="text-[#655B53] text-sm sm:text-[15px] leading-relaxed mt-4 font-normal max-w-xs">
      Creamos diseños modernos y personalizados que conectan con tu marca y cautivan a tus clientes.
    </p>

    <!-- Button -->
    <div class="mt-6">
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1C1613] text-[#FAF8F5] text-xs sm:text-sm font-medium hover:bg-[#342A24] transition-all duration-300 shadow-sm hover:gap-3 group/btn"
      >
        <span>Ver más</span>
        <ArrowRight class="w-3.5 h-3.5 transition-transform duration-300 group-hover/btn:translate-x-1" stroke-width={2.2} />
      </a>
    </div>
  </div>

  <!-- Visual Mockup Area: MacBook with Coffee Brand Page & Accent Sparks -->
  <div class="relative mt-8 sm:mt-12 z-10 pt-4 overflow-visible flex items-end justify-center">
    
    <!-- Floating accent sparks (two curved black dashes as seen in image) -->
    <div class="absolute left-2 sm:left-4 top-1/4 flex flex-col gap-1.5 z-20 pointer-events-none transition-transform duration-500 group-hover:-translate-y-1">
      <div class="w-1.5 h-4 bg-[#1C1613] rounded-full rotate-[-25deg]"></div>
      <div class="w-1.5 h-3 bg-[#1C1613] rounded-full rotate-[15deg] ml-2"></div>
    </div>

    <!-- Laptop Container with 3D perspective -->
    <div class="w-full max-w-[340px] sm:max-w-[370px] relative transition-transform duration-700 ease-out group-hover:scale-[1.03] group-hover:-rotate-1">
      
      <!-- Laptop Screen (Angled) -->
      <div class="relative bg-[#1A1816] rounded-t-xl p-1.5 shadow-2xl border border-neutral-700/50">
        <!-- Camera dot -->
        <div class="w-1.5 h-1.5 bg-neutral-600 rounded-full mx-auto mb-1"></div>

        <!-- Inner Screen Content -->
        <div class="bg-[#1C1816] rounded-md overflow-hidden text-white border border-neutral-800 relative">
          
          <!-- Mock Website Header -->
          <div class="flex items-center justify-between px-3 py-2 border-b border-neutral-800/80 bg-[#161412]">
            <span class="text-[10px] font-bold tracking-tight text-white/90">Brand</span>
            <div class="flex items-center gap-2 text-[8px] text-neutral-400">
              <span class="text-white">Inicio</span>
              <span>Acerca de</span>
              <span>Tienda</span>
              <span>Contacto</span>
              <!-- Mini Cart icon -->
              <ShoppingCart class="w-2.5 h-2.5 text-neutral-300 ml-1" stroke-width={2} />
            </div>
          </div>

          <!-- Mock Website Hero with Coffee Theme -->
          <div class="p-3 grid grid-cols-12 gap-2 items-center bg-gradient-to-br from-[#241E1A] via-[#1B1614] to-[#120F0D]">
            <!-- Hero Left: Typography & CTA -->
            <div class="col-span-7 space-y-1.5 py-1">
              <p class="text-xs sm:text-sm font-bold text-[#FAF8F5] leading-tight font-serif tracking-wide">
                Good Coffee <br />
                Good Mood.
              </p>
              <div class="pt-1">
                <span class="inline-block px-2.5 py-0.5 rounded-full bg-white/10 hover:bg-white/20 text-[8px] font-medium text-neutral-200 border border-white/10">
                  Explorar
                </span>
              </div>
            </div>

            <!-- Hero Right: Realistic Coffee Cup in Ceramic Mug -->
            <div class="col-span-5 relative flex items-center justify-center">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full relative p-1 bg-gradient-to-tr from-[#9B7B61] to-[#E3C8B4] shadow-lg flex items-center justify-center">
                <!-- Cup Inner with Latte Art -->
                <div class="w-full h-full rounded-full bg-[#3B281B] relative overflow-hidden flex items-center justify-center border-2 border-[#E7D6C7]">
                  <!-- Latte art rosette SVG pattern -->
                  <svg class="w-12 h-12 text-[#EEDFCF]" viewBox="0 0 100 100" fill="currentColor">
                    <circle cx="50" cy="50" r="42" fill="#5A3A23" />
                    <!-- Heart & Leaf latte art curves -->
                    <path d="M50 15 C45 28 32 38 32 52 C32 66 42 76 50 82 C58 76 68 66 68 52 C68 38 55 28 50 15 Z" fill="#EBD6C1" />
                    <path d="M50 25 C47 34 38 42 38 52 C38 62 45 68 50 72 C55 68 62 62 62 52 C62 42 53 34 50 25 Z" fill="#442817" />
                    <path d="M50 32 C48 38 42 45 42 52 C42 58 47 62 50 65 C53 62 58 58 58 52 C58 45 52 38 50 32 Z" fill="#F4E6D8" />
                    <circle cx="50" cy="50" r="3" fill="#3B2213" />
                  </svg>
                </div>
                <!-- Saucer / Rim glow -->
                <div class="absolute -right-2 top-1/2 -translate-y-1/2 w-3 h-5 border-2 border-[#E7D6C7] rounded-r-full"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Laptop Base / Keyboard deck (Angled perspective chassis) -->
      <div class="relative bg-gradient-to-b from-[#4A4744] via-[#2F2C2A] to-[#1C1B19] h-3.5 sm:h-4 rounded-b-lg border-t border-neutral-600 shadow-xl flex items-center justify-center">
        <!-- Trackpad notch -->
        <div class="w-14 sm:w-16 h-1 bg-[#1A1817] rounded-b-sm border-t border-neutral-500/30"></div>
      </div>
      <!-- Laptop Shadow underneath -->
      <div class="w-[90%] mx-auto h-3 bg-black/30 rounded-full blur-md -mt-1"></div>
    </div>
  </div>
</div>
