---
// Footer.astro
import { Code2 } from '@lucide/astro';

const year = new Date().getFullYear();
const phone1 = "+56 9 9287 0198";
const phone1Clean = "56992870198";
const phone2 = "+56 9 5898 6091";
const phone2Clean = "56958986091";
---

<footer class="bg-[#16120F] text-[#FAF8F5] pt-16 pb-12 border-t border-[#2A201A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-neutral-800">
      
      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="#" class="inline-flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-[#FAF8F5] text-[#1C1613] flex items-center justify-center font-bold text-lg shadow-md">
            <Code2 class="w-5 h-5 text-[#1C1613]" stroke-width={2.5} />
          </div>
          <span class="text-2xl font-bold tracking-tight text-[#FAF8F5]">
            domistudios
          </span>
        </a>

        <p class="text-sm text-[#A99889] leading-relaxed max-w-sm font-normal">
          Diseño web a medida, desarrollo de alta velocidad y soporte continuo en Chile. Creamos sitios claros, elegantes y enfocados en resultados.
        </p>

      </div>

      <!-- Links Column 1: Servicios -->
      <div class="space-y-3">
        <p class="text-sm font-bold tracking-wider uppercase text-[#E5DACE]">Servicios</p>
        <ul class="space-y-2 text-sm text-[#A99889]">
          <li><a href="#servicios" class="hover:text-white transition-colors">Diseño Web UI / UX</a></li>
          <li><a href="#servicios" class="hover:text-white transition-colors">Desarrollo Web Moderno</a></li>
          <li><a href="#servicios" class="hover:text-white transition-colors">Landing Pages</a></li>
          <li><a href="#servicios" class="hover:text-white transition-colors">Tiendas &amp; Catálogos</a></li>
          <li><a href="#servicios" class="hover:text-white transition-colors">Soporte &amp; Mantenimiento</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Proyecto & Secciones -->
      <div class="space-y-3">
        <p class="text-sm font-bold tracking-wider uppercase text-[#E5DACE]">Navegación</p>
        <ul class="space-y-2 text-sm text-[#A99889]">
          <li><a href="#proyectos" class="hover:text-white transition-colors">Proyectos</a></li>
          <li><a href="#paquetes" class="hover:text-white transition-colors">Paquetes</a></li>
          <li><a href="#nosotros" class="hover:text-white transition-colors">Sobre Nosotros</a></li>
          <li><a href="#faq" class="hover:text-white transition-colors">Preguntas Frecuentes</a></li>
          <li><a href="#contacto" class="hover:text-white transition-colors">Contacto</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Contacto con ambos números -->
      <div class="space-y-3">
        <p class="text-sm font-bold tracking-wider uppercase text-[#E5DACE]">Contacto Directo</p>
        <ul class="space-y-2.5 text-sm text-[#A99889]">
          <li>
            <a
              href={`https://wa.me/${phone1Clean}?text=Hola%20Mariana,%20quiero%20cotizar%20un%20proyecto%20web%20en%20DomiStudios`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Comunícate con Mariana</span>
            </a>
          </li>
          <li>
            <a
              href={`https://wa.me/${phone2Clean}?text=Hola%20Héctor,%20quiero%20cotizar%20un%20proyecto%20web%20en%20DomiStudios`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors flex items-center gap-2"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Comunícate con Héctor</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-[#A8988B] gap-4">
      <p>&copy; {year} DomiStudios. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="#proyectos" class="hover:text-white transition-colors">Portafolio</a>
        <a href="#contacto" class="hover:text-white transition-colors">Cotizar proyecto</a>
      </div>
    </div>
  </div>
</footer>
