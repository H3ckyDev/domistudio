---
// PackagesSection.astro
import { Check, Clock, Sparkles, ArrowRight, Info, Star } from '@lucide/astro';

const phone1Clean = "56992870198"; // Mariana
const phone2Clean = "56958986091"; // Héctor

interface PackageItem {
  id: string;
  number: string;
  name: string;
  price: string;
  tagline: string;
  description: string;
  timeframe: string;
  featured?: boolean;
  includes: string[];
  conditions: string[];
  whatsappMessage: string;
}

const packages: PackageItem[] = [
  {
    id: "start",
    number: "01",
    name: "Start",
    price: "$79.900",
    tagline: "Tu primera presencia digital.",
    description: "Pensado para emprendedores que están comenzando y necesitan una página sencilla para presentar su negocio.",
    timeframe: "3–5 días hábiles",
    featured: false,
    includes: [
      "Página web de una sola sección o landing sencilla",
      "Estructura prediseñada",
      "Personalización de colores y tipografías",
      "Nombre y descripción del negocio",
      "Breve presentación de productos o servicios",
      "Botón directo a WhatsApp",
      "Enlaces a redes sociales",
      "Diseño adaptable a celulares",
      "Publicación del sitio"
    ],
    conditions: [
      "Máximo 3 bloques de contenido",
      "El cliente entrega textos e imágenes",
      "1 ronda de ajustes",
      "Sin formularios, panel administrativo ni integraciones especiales",
      "Plazo estimado: 3–5 días hábiles",
      "Dominio y hosting no incluidos"
    ],
    whatsappMessage: "Hola, me interesa consultar por el paquete 01. Start ($79.900)"
  },
  {
    id: "basic",
    number: "02",
    name: "BASIC",
    price: "$149.900",
    tagline: "Tu negocio merece verse profesional.",
    description: "Para emprendedores que necesitan presentar sus servicios y transmitir mayor confianza.",
    timeframe: "5–7 días hábiles",
    featured: false,
    includes: [
      "Landing page de una página",
      "Hasta 4 secciones",
      "Diseño basado en plantilla personalizada",
      "Diseño responsive",
      "Botón de WhatsApp",
      "Formulario de contacto básico",
      "Integración de redes sociales",
      "Galería de imágenes",
      "SEO inicial (título y descripción)",
      "Publicación del sitio"
    ],
    conditions: [
      "El cliente proporciona textos e imágenes",
      "1 ronda de modificaciones",
      "Plazo estimado: 5–7 días hábiles",
      "Dominio y hosting no incluidos"
    ],
    whatsappMessage: "Hola, me interesa consultar por el paquete 02. BASIC ($149.900)"
  },
  {
    id: "pro",
    number: "03",
    name: "PRO",
    price: "$399.900",
    tagline: "Una experiencia digital a la altura de tu marca.",
    description: "Para negocios que buscan una presencia digital completa y un diseño personalizado.",
    timeframe: "10–15 días hábiles",
    featured: true,
    includes: [
      "Sitio web de hasta 5 páginas",
      "Diseño UX/UI personalizado",
      "Diseño responsive",
      "Página de inicio",
      "Servicios o productos",
      "Sección sobre nosotros",
      "Formulario de contacto",
      "Integración con WhatsApp",
      "Galería o portafolio",
      "Integración de Google Maps, si corresponde",
      "SEO inicial por página",
      "Google Analytics",
      "Configuración de seguridad básica",
      "Publicación del sitio"
    ],
    conditions: [
      "Diseño personalizado según identidad de marca",
      "2 rondas de modificaciones",
      "Carga inicial de contenido",
      "Plazo estimado: 10–15 días hábiles",
      "Dominio y hosting no incluidos"
    ],
    whatsappMessage: "Hola, me interesa consultar por el paquete 03. PRO ($399.900)"
  }
];
---

<section id="paquetes" class="py-12 md:py-16 relative bg-[#F5EFE6] border-t border-[#E8DED2]/60 scroll-mt-24">
  
  <!-- Subtle ambient decorative glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-full max-w-6xl h-96 bg-[#EADCCF]/25 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal max-w-3xl mx-auto text-center mb-10 sm:mb-14 space-y-3">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1C1613] tracking-tight leading-tight">
        Nuestros Paquetes
      </h2>

      <p class="text-[#655B53] text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
        Pensados para cada etapa de tu negocio, con entregas ágiles, diseño cuidado y comunicación directa.
      </p>
    </div>

    <!-- Pricing Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch max-w-6xl mx-auto">
      {packages.map((pkg, idx) => (
        <div class={`h-full ${pkg.featured ? 'lg:-translate-y-2' : ''}`}>
          <div
            class={`reveal delay-${(idx + 1) * 100} h-full relative rounded-[32px] p-7 sm:p-9 flex flex-col justify-between transition-all duration-300 ${
              pkg.featured
                ? 'bg-[#1C1613] text-[#FAF8F5] border-2 border-[#8E735B]/70 shadow-[0_25px_60px_-15px_rgba(28,22,19,0.35)] plan-shake'
                : 'bg-[#FAF6F0] text-[#1C1613] border border-[#E7DDD1] shadow-[0_15px_40px_-15px_rgba(45,32,24,0.06)] hover:shadow-xl hover:-translate-y-1'
            }`}
          >
            {/* Top Info */}
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span
                  class={`text-xs font-extrabold tracking-widest uppercase px-3 py-1 rounded-full ${
                    pkg.featured
                      ? 'bg-white/10 text-[#DDCFC0]'
                      : 'bg-[#E5DACE] text-[#6E4E35]'
                  }`}
                >
                  {pkg.number}. {pkg.name}
                </span>

                {pkg.featured && (
                  <span class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-[#FAF8F5] text-[#1C1613] text-xs font-bold tracking-wide shadow-md">
                    <Star class="w-3.5 h-3.5 text-[#8E735B] fill-current star-pulse" stroke-width={2} />
                    <span>Más recomendado</span>
                  </span>
                )}
              </div>

            <!-- Price -->
            <div class="flex items-baseline gap-2 mt-2">
              <span class={`text-4xl sm:text-5xl font-black tracking-tight ${pkg.featured ? 'text-[#FAF8F5]' : 'text-[#1C1613]'}`}>
                {pkg.price}
              </span>
              <span class={`text-xs font-semibold uppercase tracking-wider ${pkg.featured ? 'text-[#C7B49E]' : 'text-[#7D736A]'}`}>
                CLP
              </span>
            </div>

            <!-- Tagline & Description -->
            <h3 class={`text-base font-bold mt-3 leading-snug ${pkg.featured ? 'text-[#FAF8F5]' : 'text-[#1C1613]'}`}>
              {pkg.tagline}
            </h3>

            <p class={`text-sm leading-relaxed mt-2 ${pkg.featured ? 'text-[#DDCFC0]' : 'text-[#655B53]'}`}>
              {pkg.description}
            </p>

            <!-- Timeframe Badge -->
            <div
              class={`mt-4 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold ${
                pkg.featured
                  ? 'bg-white/10 text-[#FAF8F5] border border-white/10'
                  : 'bg-[#EAE0D3]/70 text-[#4D4238] border border-[#E0D3C5]'
              }`}
            >
              <Clock class="w-3.5 h-3.5 text-[#8E735B] shrink-0" stroke-width={2.2} />
              <span>Plazo estimado: <strong>{pkg.timeframe}</strong></span>
            </div>

            <!-- Divider -->
            <div class={`h-px my-6 ${pkg.featured ? 'bg-white/15' : 'bg-[#E8DED2]'}`}></div>

            <!-- What's included list -->
            <div class="space-y-3">
              <p class={`text-xs font-extrabold uppercase tracking-wider ${pkg.featured ? 'text-[#DDCFC0]' : 'text-[#6E4E35]'}`}>
                Incluye:
              </p>
              <ul class="space-y-2.5">
                {pkg.includes.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm">
                    <span
                      class={`w-4 h-4 rounded-full flex items-center justify-center shrink-0 mt-0.5 ${
                        pkg.featured
                          ? 'bg-emerald-400/20 text-emerald-400'
                          : 'bg-emerald-500/15 text-emerald-700'
                      }`}
                    >
                      <Check class="w-3 h-3" stroke-width={3} />
                    </span>
                    <span class={pkg.featured ? 'text-[#FAF8F5]' : 'text-[#3E342D]'}>
                      {item}
                    </span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Conditions & details -->
            <div class={`mt-6 pt-5 border-t ${pkg.featured ? 'border-white/10' : 'border-[#E8DED2]/80'}`}>
              <p class={`text-[11px] font-bold uppercase tracking-wider mb-2.5 flex items-center gap-1.5 ${pkg.featured ? 'text-[#C7B49E]' : 'text-[#6E4E35]'}`}>
                <Info class="w-3.5 h-3.5" stroke-width={2} />
                <span>Condiciones:</span>
              </p>
              <ul class="space-y-1.5">
                {pkg.conditions.map((cond) => (
                  <li class={`text-xs flex items-start gap-2 ${pkg.featured ? 'text-[#C7B49E]' : 'text-[#655B53]'}`}>
                    <span class={`font-bold shrink-0 ${pkg.featured ? 'text-[#8E735B]' : 'text-[#8E735B]'}`}>&bull;</span>
                    <span>{cond}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Bottom CTA Button & Line Options -->
          <div class="mt-8 pt-4">
            <a
              href={`https://wa.me/${phone1Clean}?text=${encodeURIComponent(pkg.whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class={`w-full py-3.5 px-5 rounded-2xl font-bold text-sm flex items-center justify-center gap-2 transition-all duration-300 shadow-sm group/btn ${
                pkg.featured
                  ? 'bg-[#FAF8F5] text-[#1C1613] hover:bg-white hover:shadow-lg hover:scale-[1.02]'
                  : 'bg-[#1C1613] text-[#FAF8F5] hover:bg-[#342A24] hover:shadow-md hover:scale-[1.01]'
              }`}
              aria-label={`Elegir paquete ${pkg.name}`}
            >
              <span>Elegir {pkg.name}</span>
              <ArrowRight class="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" stroke-width={2.2} />
            </a>

            <!-- Direct Contact Selection (Mariana / Héctor) -->
            <div class="mt-3 flex items-center justify-center gap-2 text-[11px]">
              <span class={pkg.featured ? 'text-[#A99889]' : 'text-[#7D736A]'}>Escríbele a:</span>
              <a
                href={`https://wa.me/${phone1Clean}?text=${encodeURIComponent(pkg.whatsappMessage + ' (Hola Mariana)')}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`font-semibold underline transition-colors ${pkg.featured ? 'text-[#FAF8F5] hover:text-[#DDCFC0]' : 'text-[#1C1613] hover:text-[#8E735B]'}`}
              >
                Mariana
              </a>
              <span class={pkg.featured ? 'text-white/20' : 'text-[#D4C4B5]'}>|</span>
              <a
                href={`https://wa.me/${phone2Clean}?text=${encodeURIComponent(pkg.whatsappMessage + ' (Hola Héctor)')}`}
                target="_blank"
                rel="noopener noreferrer"
                class={`font-semibold underline transition-colors ${pkg.featured ? 'text-[#FAF8F5] hover:text-[#DDCFC0]' : 'text-[#1C1613] hover:text-[#8E735B]'}`}
              >
                Héctor
              </a>
            </div>
          </div>
        </div>
      </div>
      ))}
    </div>

    <!-- Bottom Note & Hosting Clarification -->
    <div class="reveal mt-12 max-w-3xl mx-auto p-6 rounded-2xl bg-[#FAF6F0] border border-[#E7DDD1] text-center space-y-2">
      <p class="text-xs sm:text-sm text-[#5D544C] leading-relaxed">
        <strong class="text-[#1C1613]">Transparencia:</strong> El dominio web (.cl o .com) y el hosting no están incluidos en los paquetes, pero te asesoramos paso a paso para adquirirlos directamente a tu nombre en NIC Chile o el proveedor que prefieras con total propiedad.
      </p>
      <p class="text-xs text-[#655B53]">
        ¿Necesitas funcionalidades personalizadas, tienda online o integraciones especiales? 
        <a href="#contacto" class="text-[#1C1613] font-bold underline hover:text-[#8E735B] ml-1">
          Conversemos para preparar una propuesta a tu medida.
        </a>
      </p>
    </div>

  </div>
</section>

<style>
  @keyframes attentionShake {
    0%, 68%, 100% {
      transform: rotate(0deg) scale(1);
    }
    70% {
      transform: rotate(-2deg) scale(1.015);
    }
    73% {
      transform: rotate(2.5deg) scale(1.02);
      box-shadow: 0 30px 65px -12px rgba(28, 22, 19, 0.45), 0 0 28px rgba(201, 145, 111, 0.35);
    }
    76% {
      transform: rotate(-2deg) scale(1.015);
    }
    79% {
      transform: rotate(1.8deg) scale(1.01);
    }
    82% {
      transform: rotate(-1deg) scale(1.005);
    }
    85% {
      transform: rotate(0.8deg) scale(1);
    }
    88% {
      transform: rotate(0deg) scale(1);
    }
  }

  @keyframes starPulse {
    0%, 100% {
      transform: scale(1) rotate(0deg);
    }
    50% {
      transform: scale(1.25) rotate(18deg);
    }
  }

  .plan-shake {
    animation: attentionShake 4s ease-in-out infinite;
    transform-origin: center 25%;
    will-change: transform, box-shadow;
  }

  /* Pausa el shake cuando el usuario interactúa o pasa el cursor encima */
  .plan-shake:hover {
    animation-play-state: paused;
  }

  .star-pulse {
    display: inline-block;
    animation: starPulse 2.2s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-shake,
    .star-pulse {
      animation: none !important;
    }
  }
</style>
