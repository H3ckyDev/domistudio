---
// PillarsSection.astro
import DesignCard from './DesignCard.astro';
import DevelopmentCard from './DevelopmentCard.astro';
import SupportCard from './SupportCard.astro';
---

<section id="servicios" class="py-12 md:py-16 relative overflow-hidden bg-gradient-to-b from-[#F5EFE6] via-[#FAF6F0] to-[#F5EFE6] scroll-mt-24">
  
  <!-- Subtle decorative ambient accents -->
  <div class="absolute top-10 left-1/4 w-96 h-96 bg-[#EADCCF]/30 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-1/4 w-96 h-96 bg-[#E3D1BE]/40 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal max-w-3xl mx-auto text-center mb-10 sm:mb-12 space-y-3">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1C1613] tracking-tight leading-tight">
        Nuestros Pilares
      </h2>
    </div>

    <!-- The 3 Cards Showcase (Exact Layout from Image) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 items-stretch">
      <!-- Card 1: Diseño -->
      <div class="reveal delay-100 h-full">
        <DesignCard className="h-full min-h-[580px]" />
      </div>

      <!-- Card 2: Desarrollo -->
      <div class="reveal delay-200 h-full">
        <DevelopmentCard className="h-full min-h-[580px]" />
      </div>

      <!-- Card 3: Soporte -->
      <div class="reveal delay-300 h-full">
        <SupportCard className="h-full min-h-[580px]" />
      </div>
    </div>

  </div>
</section>
