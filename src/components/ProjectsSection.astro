---
// ProjectsSection.astro
import { ChevronLeft, ChevronRight, Lock, ExternalLink } from '@lucide/astro';

interface Project {
  id: string;
  title: string;
  urlDisplay: string;
  urlHref: string;
  image: string;
  imageWebp: string;
  imageWebp640: string;
  imageAlt: string;
  ctaText: string;
}

const projects: Project[] = [
  {
    id: "ramas",
    title: "RAMAS | Máquinas Expendedoras para Empresas",
    urlDisplay: "https://www.ramas.cl/",
    urlHref: "https://www.ramas.cl/",
    image: "/images/ramas.png",
    imageWebp: "/images/ramas.webp",
    imageWebp640: "/images/ramas-640.webp",
    imageAlt: "Captura del sitio web ramas.cl",
    ctaText: "Visitar ramas.cl",
  },
  {
    id: "fifacoins",
    title: "FIFA Coins Colombia | Plataforma de Monedas FC",
    urlDisplay: "https://fifacoinscolombia.com/",
    urlHref: "https://fifacoinscolombia.com/",
    image: "/images/fifacoins.png",
    imageWebp: "/images/fifacoins.webp",
    imageWebp640: "/images/fifacoins-640.webp",
    imageAlt: "Captura del sitio web fifacoinscolombia.com",
    ctaText: "Visitar fifacoinscolombia.com",
  },
];
---

<section id="proyectos" class="py-12 md:py-16 relative bg-[#F5EFE6] select-none scroll-mt-24" tabindex="0" aria-label="Sección de proyectos">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header with Arrows Only -->
    <div class="reveal flex items-center justify-between gap-6 mb-8 sm:mb-10 max-w-5xl mx-auto">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1C1613] tracking-tight leading-tight">
        Proyectos
      </h2>

      <!-- Navigation Arrows Only -->
      <div class="flex items-center gap-3">
        <button
          id="project-prev-btn"
          type="button"
          aria-label="Proyecto anterior"
          class="w-12 h-12 rounded-full bg-[#FAF6F0] border border-[#E7DDD1] text-[#1C1613] hover:bg-[#1C1613] hover:text-[#FAF8F5] transition-all duration-300 flex items-center justify-center shadow-sm hover:scale-105 active:scale-95 cursor-pointer"
        >
          <ChevronLeft class="w-5 h-5" stroke-width={2.2} />
        </button>
        <button
          id="project-next-btn"
          type="button"
          aria-label="Siguiente proyecto"
          class="w-12 h-12 rounded-full bg-[#FAF6F0] border border-[#E7DDD1] text-[#1C1613] hover:bg-[#1C1613] hover:text-[#FAF8F5] transition-all duration-300 flex items-center justify-center shadow-sm hover:scale-105 active:scale-95 cursor-pointer"
        >
          <ChevronRight class="w-5 h-5" stroke-width={2.2} />
        </button>
      </div>
    </div>

    <!-- Carousel Container -->
    <div class="max-w-5xl mx-auto relative overflow-hidden rounded-[36px]">
      
      <!-- Carousel Track -->
      <div
        id="project-carousel-track"
        class="flex transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] will-change-transform cursor-grab active:cursor-grabbing"
      >
        {projects.map((project) => (
          <div class="project-carousel-slide min-w-full w-full shrink-0">
            
            <div class="bg-[#FAF6F0] rounded-[36px] border border-[#E7DDD1] shadow-xl overflow-hidden flex flex-col justify-between group">
              
              <!-- Screenshot Container with Browser Frame -->
              <div class="bg-[#1C1613] p-4 sm:p-6 border-b border-[#E8DED2]">
                
                <!-- Mock Browser Chrome Bar -->
                <div class="bg-[#2A231F] rounded-t-xl px-4 py-2.5 flex items-center justify-between border-b border-white/10 text-xs">
                  <div class="flex items-center gap-2">
                    <div class="w-3 h-3 rounded-full bg-[#EF4444]"></div>
                    <div class="w-3 h-3 rounded-full bg-[#F59E0B]"></div>
                    <div class="w-3 h-3 rounded-full bg-[#10B981]"></div>
                  </div>
                  
                  <!-- Browser URL Bar -->
                  <a
                    href={project.urlHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center gap-2 px-3 py-1 rounded-md bg-[#1C1613] text-[#FAF8F5]/80 hover:text-white text-[11px] font-mono border border-white/10 transition-colors"
                  >
                    <Lock class="w-3 h-3 text-emerald-400" stroke-width={2} />
                    <span>{project.urlDisplay}</span>
                    <ExternalLink class="w-3 h-3 text-[#A99889]" stroke-width={2} />
                  </a>

                  <span class="text-[10px] text-emerald-400 font-medium hidden sm:inline">
                    En línea
                  </span>
                </div>

                <!-- Screenshot Image (Optimized Next-Gen Responsive WebP) -->
                <div class="relative overflow-hidden rounded-b-xl bg-black aspect-[16/10] sm:aspect-[16/9]">
                  <picture>
                    <source
                      type="image/webp"
                      srcset={`${project.imageWebp640} 640w, ${project.imageWebp} 1280w`}
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 700px, 920px"
                    />
                    <img
                      src={project.imageWebp}
                      srcset={`${project.imageWebp640} 640w, ${project.imageWebp} 1280w`}
                      sizes="(max-width: 768px) 100vw, (max-width: 1200px) 700px, 920px"
                      alt={project.imageAlt}
                      width="1280"
                      height="820"
                      class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                      loading={project.id === "ramas" ? "eager" : "lazy"}
                      fetchpriority={project.id === "ramas" ? "high" : "auto"}
                      decoding="async"
                    />
                  </picture>
                  <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-b-xl pointer-events-none"></div>
                </div>

              </div>

              <!-- Project Footer: Title & Action Button Only (No tags, no description) -->
              <div class="p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <h3 class="text-2xl sm:text-3xl font-bold text-[#1C1613]">
                  {project.title}
                </h3>

                <a
                  href={project.urlHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#1C1613] text-[#FAF8F5] text-xs sm:text-sm font-medium hover:bg-[#342A24] transition-all shadow-sm hover:scale-105 active:scale-95 shrink-0"
                >
                  <span>{project.ctaText}</span>
                  <ExternalLink class="w-3.5 h-3.5" stroke-width={2} />
                </a>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  function initProjectCarousel() {
    const track = document.getElementById('project-carousel-track');
    const slides = document.querySelectorAll('.project-carousel-slide');
    const prevBtn = document.getElementById('project-prev-btn');
    const nextBtn = document.getElementById('project-next-btn');

    if (!track || slides.length === 0) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let touchStartX = 0;
    let touchEndX = 0;

    function goToSlide(index: number) {
      if (index < 0) {
        currentIndex = totalSlides - 1;
      } else if (index >= totalSlides) {
        currentIndex = 0;
      } else {
        currentIndex = index;
      }

      // Smooth translation
      track.style.transform = `translateX(-${currentIndex * 100}%)`;
    }

    // Prev / Next button clicks
    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      goToSlide(currentIndex + 1);
    });

    // Touch Swipe support
    track.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    track.addEventListener('touchend', (e: TouchEvent) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });

    function handleSwipe() {
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          goToSlide(currentIndex + 1);
        } else {
          goToSlide(currentIndex - 1);
        }
      }
    }

    // Keyboard navigation when section is focused
    const section = document.getElementById('proyectos');
    section?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        goToSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        goToSlide(currentIndex + 1);
      }
    });

    // Initial state
    goToSlide(0);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectCarousel);
  } else {
    initProjectCarousel();
  }
  document.addEventListener('astro:page-load', initProjectCarousel);
</script>
