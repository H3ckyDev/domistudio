---
// ProjectsSection.astro
---

<section id="proyectos" class="py-20 md:py-32 relative bg-[#F5EFE6]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="reveal max-w-3xl mx-auto text-center mb-16 space-y-4">
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1C1613] tracking-tight leading-tight">
        Proyectos
      </h2>
    </div>

    <!-- Projects Grid / Showcase -->
    <div class="max-w-4xl mx-auto">
      
      <!-- Project 1: RAMAS.CL (With Real Screenshot) -->
      <div class="reveal delay-100 bg-[#FAF6F0] rounded-[36px] border border-[#E7DDD1] shadow-xl overflow-hidden flex flex-col justify-between group">
        
        <!-- Real Screenshot Container with Browser Frame -->
        <div class="bg-[#1C1613] p-4 sm:p-6 border-b border-[#E8DED2]">
          
          <!-- Mock Browser Chrome Bar -->
          <div class="bg-[#2A231F] rounded-t-xl px-4 py-2.5 flex items-center justify-between border-b border-white/10 text-xs">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-[#EF4444]"></div>
              <div class="w-3 h-3 rounded-full bg-[#F59E0B]"></div>
              <div class="w-3 h-3 rounded-full bg-[#10B981]"></div>
            </div>
            
            <!-- Real Website URL Bar -->
            <a
              href="https://www.ramas.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-3 py-1 rounded-md bg-[#1C1613] text-[#FAF8F5]/80 hover:text-white text-[11px] font-mono border border-white/10 transition-colors"
            >
              <svg class="w-3 h-3 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>https://www.ramas.cl/</span>
              <svg class="w-3 h-3 text-[#A99889]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>

            <span class="text-[10px] text-emerald-400 font-medium hidden sm:inline">En línea</span>
          </div>

          <!-- Real Screenshot Image -->
          <div class="relative overflow-hidden rounded-b-xl bg-black aspect-[16/10] sm:aspect-[16/9]">
            <img
              src="/images/ramas.png"
              alt="Captura real del sitio web ramas.cl desarrollado por DomiStudios"
              class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-[1.03]"
              loading="lazy"
            />
            <div class="absolute inset-0 ring-1 ring-inset ring-white/10 rounded-b-xl pointer-events-none"></div>
          </div>

        </div>

        <!-- Project Details -->
        <div class="p-6 sm:p-8 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <span class="text-xs uppercase font-bold tracking-wider text-[#8E735B]">
                Desarrollo Web &bull; Vending Corporativo
              </span>
              <h3 class="text-2xl font-bold text-[#1C1613] mt-0.5">
                RAMAS | Máquinas Expendedoras para Empresas
              </h3>
            </div>
            
            <span class="px-3 py-1 rounded-full bg-[#E5DACE] text-[#2C241E] text-xs font-semibold">
              Chile
            </span>
          </div>

          <!-- Badges & Action Link -->
          <div class="pt-4 flex flex-wrap items-center justify-between gap-4">

            <a
              href="https://www.ramas.cl/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1C1613] text-[#FAF8F5] text-xs sm:text-sm font-medium hover:bg-[#342A24] transition-all shadow-sm hover:scale-105"
            >
              <span>Visitar ramas.cl</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
            </a>
          </div>

        </div>

      </div>

    </div>

  </div>
</section>
