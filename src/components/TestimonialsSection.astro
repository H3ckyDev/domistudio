---
// TestimonialsSection.astro
---

<section class="py-20 md:py-28 relative bg-[#FAF6F0] border-t border-[#E8DED2]/80">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="reveal bg-[#F5EFE6] rounded-[36px] p-8 sm:p-14 border border-[#E8DED2] shadow-sm relative overflow-hidden">
      
      <!-- Subtle quotation mark watermark -->
      <div class="absolute -right-6 -bottom-10 text-[180px] font-serif text-[#E5DACE]/40 pointer-events-none select-none font-bold leading-none">
        &rdquo;
      </div>

      <div class="relative z-10 max-w-3xl space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#E5DACE] text-[#2C241E] text-xs font-semibold tracking-wide">
          <span>Experiencia de Cliente</span>
        </div>

        <!-- Authentic client experience quote -->
        <blockquote class="text-xl sm:text-2xl lg:text-3xl text-[#1C1613] font-serif italic leading-relaxed">
          &ldquo;Trabajar con DomiStudio fue una experiencia impecable de principio a fin. Captaron de inmediato la estética que buscábamos, el sitio web carga al instante y la comunicación fue siempre directa, cercana y transparente.&rdquo;
        </blockquote>

        <div class="pt-4 flex items-center gap-4">
          <div class="w-12 h-12 rounded-full bg-[#1C1613] text-[#FAF8F5] flex items-center justify-center font-bold text-sm">
            DS
          </div>
          <div>
            <h4 class="text-base font-bold text-[#1C1613] leading-tight">Clientes satisfechos</h4>
            <p class="text-xs sm:text-sm text-[#7D736A] mt-0.5">
              Marcas y empresas que confían en nuestro trabajo en Chile
            </p>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
